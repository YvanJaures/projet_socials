<main>
    <div class="top">
        <span class="options">
            <i class="fa fa-moon"></i>
            <i class="fa fa-share"></i>
        </span>
        <span class="profil_pic">
            <img src={{user.prof_img}} alt="image de profile" id="image_profile"> 
            <i class="fa fa-pen" id="pen"><input type="file" name="profile" id="prof-change" accept="image/*"> </i>
             
        </span>
        <h5>@{{user.user_name}}</h5>
        <h2 id="name_profile">{{user.name}} {{user.prenom}} </h2>
        <p class="error"></p>
        <h4 id="email_profile">{{user.email}} </h4>
        <p class="error"></p>
        <button id="update-button">Modifier</button>
        <ul class="socials_list">
            {{#each links}}
                <li>
                    <a href="{{this.url}}">
                        <i class="fa fa-{{this.icon}}"></i>
                    </a>
                </li>
            {{/each}}
        </ul>
        <form class="add">
            <span class="add_btn">
                <h3>Ajouter un lien</h3>
                <input type="submit" value="+">
            </span>
            <select name="réseaux sociaux" id="socials">
                {{#each icons}}
                    <option value={{this.title}}>{{this.title}}</option>
                {{/each}}
            </select>
            <input type="text" name="titre" id="title" placeholder="Titre" required>
            <input type="text" name="lien" id="link" placeholder="Coller le lien ici" required>
            <p class="error"></p>
        </form>
        <section>
            <table>
            <caption>Liste de liens</caption> 
            <thead>
                    <th>Selectionner</th>
                    <th>Média</th>
                    <th>Titre</th>
                    <th>Lien</th>
            </thead>
            <tbody id="tab-body">
                    {{#each links}}
                        <tr class="info-line" id="{{this.id}}">
                            <td><input type="checkbox" class="check-line"></td>
                            <td>{{this.icon}}</td>
                            <td>{{this.title}}</td>
                            <td>{{this.url}}</td>
                        </tr>
                    {{/each}}
            </tbody>
            </table>
            <div class="edit_input">
                Edition
                <input type="text" name="edition titre" id="edit_title" class="edit" placeholder="Titre">
                <!--<input type="text" name="edition lien" id="edit_link" class="edit" placeholder="Lien">-->
            </div>
            <div class="validate">
                <input type="button" name="valider edition" id="modify" value="MODIFIER">
                <input type="button" name="supprimer lien" id="delete" value="SUPPRIMER">
            </div>
        </section>
        <p class="error"></p>
    </div>
    <ul class="middle">
            {{#each links}}
            <li class="link" id="li{{this.id}}">
                <a href="{{this.url}}">
                    <i class="fa fa-{{this.icon}}"></i>
                    <p>{{this.title}}</p>
                </a>
            </li>
            {{/each}}
        </ul>
    <div class="bottom">
        <p>généré avec <a href="/login"><img src="../assets/linkme_lin.png" alt="logo linkme" class="logo"></a> @allrightsreserved</p>
    </div>
    <form class="update-user">
        <h2>MODIFIER</h2>
        <Select id="updated-alias">
            <option value="name">Name</option>
            <option value="prenom">Prenom</option>
            <option value="email">Email</option>
        </Select>
        <input type="text" name="email" id="update" placeholder="exemple">
        <p class="error"></p>
        <button type="submit">Valider</button>
    </form>
</main>